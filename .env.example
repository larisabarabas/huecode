# Copy this file to .env and set ONE provider key. Keys are only ever read
# server-side (server/ai/config.ts) — they are never sent to the browser.
#
# AI is optional: with no key the "Enhance with AI" toggle is hidden and the
# built-in generator is used.

# Which provider to use: anthropic | openai | gemini.
# Optional if exactly one key below is set; required if you set more than one.
# AI_PROVIDER=anthropic

ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=

# Optional overrides:
# PORT=8787
# AI_MODEL=   # defaults: claude-haiku-4-5 / gpt-6-luna / gemini-3.5-flash-lite (ANTHROPIC_MODEL still works)

# Hosted-demo only: tells users the shared key has a spend cap. Leave unset when self-hosting.
# AI_DEMO_MODE=true
