{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "skipLibCheck": true,
    "noEmit": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "esModuleInterop": true
  },
  "include": [
    "server",
    "src/lib/types.ts",
    "src/lib/color.ts",
    "src/lib/paletteBuilder.ts",
    "src/lib/keywordDictionary.ts"
  ]
}
